# Get a key at https://openrouter.ai/keys, then copy this file to .env.local
OPENROUTER_API_KEY=
# Any OpenRouter model with image input + structured outputs. Default: anthropic/claude-opus-5.5
# Cheaper options to compare: anthropic/claude-sonnet-5.5, google/gemini-3.8-flash
OPENROUTER_MODEL=anthropic/claude-opus-5.5
