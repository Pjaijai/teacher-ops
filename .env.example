# Copy to .env.local for local development.

# local (v1): no database or sign-in; work is saved in the browser. cloud: accounts + Postgres.
NEXT_PUBLIC_APP_MODE=local

# OpenRouter (AI + embeddings): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Top model: handwriting, grading, marking, level samples. Light model: helpers, 解題, question generation.
OPENROUTER_MODEL_TOP=anthropic/claude-opus-5.5
OPENROUTER_MODEL_LIGHT=anthropic/claude-sonnet-5.5
OPENROUTER_EMBED_MODEL=qwen/qwen3-embedding-8b

# Database. Leave DATABASE_URL empty to use embedded PGlite in ./data/pglite (no install needed).
# Set it to a Postgres with pgvector + pg_trgm (e.g. Railway) to use that instead.
DATABASE_URL=
# PGLITE_DIR=./data/pglite

# Auth (Better Auth). Use a long random secret in production.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional extra origins, comma-separated
BETTER_AUTH_TRUSTED_ORIGINS=
# Google sign-in (optional locally)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email sign-in codes via Resend. Without a key, codes are printed in the dev server log.
RESEND_API_KEY=
EMAIL_FROM=DSE Practice <no-reply@example.com>
